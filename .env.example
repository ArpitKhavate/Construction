# BuildWright: environment template.
# Copy this file to .env.local and fill in the values. Never commit .env.local, and share real
# keys privately (password manager or direct message), never through git: this repo is public.
# Research (city maps, zoning, flood, permits) needs no keys at all. Everything below is optional.

# Claude agents. Optional. Powers the five research agents with Claude Haiku 5.5.
# If empty, each agent falls back to rule-written text built from the same city facts.
# Get it in the Claude Console under Settings > API keys.
ANTHROPIC_API_KEY=

# Apify builders. Optional. Looks up 5 local builders on Google Maps for each run.
# If empty, a bundled list of real Austin builders is shown instead.
# Get it at https://console.apify.com/settings/integrations
APIFY_API_TOKEN=

# Email sending. Optional. Needed only to actually send the email draft.
# EMAIL_FROM is required for any sending. Resend is used when RESEND_API_KEY is set,
# otherwise SMTP. If both are empty, the draft still shows and sending explains what is missing.
# Resend key: https://resend.com/api-keys (EMAIL_FROM must be on a domain verified in Resend).
EMAIL_FROM=
RESEND_API_KEY=
# SMTP alternative (for example a Gmail app password). SMTP_PORT defaults to 587.
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=

# Twilio calls. Optional. Needed only to actually place the phone call.
# All three are required for calling; if any is empty, the script still shows and calling explains what is missing.
# Trial accounts can only call verified numbers. Get them at https://console.twilio.com
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

# Outreach allowlist. Required for any real email or call to go out.
# Sends only go to DEMO_EMAIL, DEMO_PHONE and these extra comma-separated emails or phone numbers.
# If all are empty, every send is refused, so a deployed copy can't be used to spam or dial anyone.
OUTREACH_ALLOW_TO=

# Demo prefills. Optional. Your own email and phone, prefilled on the results page and allowed as recipients.
# Nothing is sent until you tick the approval box on the review screen.
DEMO_EMAIL=
DEMO_PHONE=
