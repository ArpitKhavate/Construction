# Email. Resend is used when RESEND_API_KEY is set. Otherwise SMTP is used.
RESEND_API_KEY=
EMAIL_FROM=

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# Twilio voice. Trial accounts can only call verified numbers.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

# Optional prefills. Nothing is sent until you approve it on the review screen.
DEMO_EMAIL=
DEMO_PHONE=

# Claude Haiku agents. Without it, agents fall back to rule-written text.
ANTHROPIC_API_KEY=

# Apify builder lookup. Without it, a bundled list of Austin builders is used.
APIFY_API_TOKEN=
