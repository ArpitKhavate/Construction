# Copy to .env.local and fill in. Never commit .env.local.
#   cp .env.example .env.local

# --- Claude (Anthropic) ------------------------------------------------------
# https://console.anthropic.com -> API Keys
ANTHROPIC_API_KEY=

# --- Supabase ----------------------------------------------------------------
# Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-side only. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# --- Apify -------------------------------------------------------------------
# https://console.apify.com -> Settings -> API & Integrations
APIFY_API_TOKEN=

# --- Optional ----------------------------------------------------------------
# Socrata app token for data.austintexas.gov (raises rate limits; works without)
AUSTIN_SOCRATA_APP_TOKEN=
